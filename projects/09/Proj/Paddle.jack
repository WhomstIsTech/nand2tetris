/*
This is the Paddle class for controlling the paddle for pong
*/

class Paddle {
    field int x;
    field int y;
    field int w;
    field int h;
    field int speed;

    constructor Paddle new(int x0, int y0, int width, int height) {
        /*
        Initialize the paddle with its initial position and its width and height (doesn't matter as much)
        */
        let x = x0;
        let y = y0;
        let w = width;
        let h = height;
        let speed = 4;
        return this;
    }
    
    method void moveLeft() {
        /*
        Move the paddle to the left as long as its current location
        can stay on the screen
        */
        var int tempCheckX;

        let tempCheckX = x - speed;

        do clearDraw();

        if (tempCheckX > 0) {
            let x = x - speed;
        }

        do draw();

        return;
    }

    method void moveRight() {
        /*
        Move the paddle to the right as long as its width + its current location
        can stay on the screen
        */
        var int tempCheckX;

        let tempCheckX = x + speed;
        let tempCheckX = tempCheckX + w;

        do clearDraw();

        if (tempCheckX < 512) {
            let x = x + speed;
        }

        do draw();

        return;
    }

    method void clearDraw() {
        do Screen.setColor(false);
        do draw();
        do Screen.setColor(true);
        return;
    }

    method void draw() {
        /*
            Draws a rectangle such that the top left corner is what the object stores
            |
            V
            *----------------  -
            |               |  |  h
            -----------------  -

            |----------------|
                    w
        */
        var int topRight;
        var int bottomRight;

        let topRight = x + w;
        let topRight = topRight - 1;

        let bottomRight = y + h;
        let bottomRight = bottomRight - 1;

        do Screen.drawRectangle(x, y, topRight, bottomRight);

        return;
    }

    method void reduceWidth(int sizeReduction) {
        /*
        Reduce the width of the paddle by the size of sizeReduction
        */

        do clearDraw();

        if (w - sizeReduction > 4) {
            let w = w - sizeReduction;
        }

        do draw();

        return;
    }


    method void increaseWidth(int sizeIncrease) {
        /*
        Increase the width of the paddle as long as it's smaller than the screen width
        */

        do clearDraw();
        
        if (x + w + sizeIncrease < 512) {
            let w = w + sizeIncrease;
        }

        do draw();

        return;
    }

    method void changeSpeed(int spd) {
        /*
        Alter the speed as long as it's greater than 0
        */
        if (spd > 0) {
            let speed = spd;
        }
        return;
    }

    method int getX() {
        return x;
    }

    method int getY() {
        return y;
    }

    method int getH() {
        return h;
    }

    method int getW() {
        return w;
    }
    
    // Eliminate the paddle from memory
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}