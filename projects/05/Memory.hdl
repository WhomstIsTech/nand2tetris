// File name: projects/5/Memory.hdl
/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load=1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory chip are used. 
 * Access to address>0x6000 is invalid. Access to any address in 
 * the range 0x4000-0x5FFF results in accessing the screen memory 
 * map. Access to address 0x6000 results in accessing the keyboard 
 * memory map. The behavior in these addresses is described in the Screen
 * and Keyboard chip specifications given in the lectures and the book.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
	//// Replace this comment with your code.
    // Invert upper address bits for logic
    Not(in=address[13], out=addr13Inv);

    // Check if address in range for RAM then unlocking it and sending to Mux
    Not(in=address[14], out=ramAddr); //Looking for upper bit of address to look like 0
    And(a=load, b=ramAddr, out=unlockRam);
    RAM16K(in=in, load=unlockRam, address=address[0..13], out=toMuxRAM);

    // Check if address in range for screen then unlock and send to Mux
    And(a=address[14], b=addr13Inv, out=scrnAddr); //Looking for upper bits of address to look like 10
    And(a=load, b=scrnAddr, out=unlockScreen);
    Screen(in=in, load=unlockScreen, address=address[0..12], out=toMuxSCRN);

    // Send keyboard to Mux
    Keyboard(out=toMuxKBD);

    // Mux to switch the output based on address at the end
    Mux16(a=toMuxKBD, b=toMuxSCRN, sel=scrnAddr, out=toOtherMux); // Do we send screen or keyboard?
    Mux16(a=toOtherMux, b=toMuxRAM, sel=ramAddr, out=out); // Do we send RAM or whatever from previous Mux?
}