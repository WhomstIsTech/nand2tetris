// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    // Whenever we perform a function we have to unlock the register
    Or(a=inc, b=load, out=checkReset);
    Or(a=checkReset, b=reset, out=unlockRegister);

    // Perform Increment
    Inc16(in=toInc, out=toIncInc);
    Mux16(a=toInc, b=toIncInc, sel=inc, out=toLoad);

    // Perform Loading
    Mux16(a=toLoad, b=in, sel=load, out=toReset);

    // Perform Reseting Counter
    Mux16(a=toReset, b=false, sel=reset, out=toReg);

    // Register
    Register(in=toReg, load=unlockRegister, out=out, out=toInc);
}
