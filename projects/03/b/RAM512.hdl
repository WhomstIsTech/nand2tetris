// File name: projects/3/b/RAM512.hdl
/**
 * Memory of 512 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM512 {
    IN in[16], load, address[9];
    OUT out[16];

    PARTS:
    // Split out the load pin to only select the proper register to unlock
    DMux8Way(in=load, sel=address[6..8], a=loadReg0, b=loadReg1, c=loadReg2, d=loadReg3, e=loadReg4, f=loadReg5, g=loadReg6, h=loadReg7);

    // Register stack
    RAM64(in=in, load=loadReg0, address=address[0..5], out=reg0);
    RAM64(in=in, load=loadReg1, address=address[0..5], out=reg1);
    RAM64(in=in, load=loadReg2, address=address[0..5], out=reg2);
    RAM64(in=in, load=loadReg3, address=address[0..5], out=reg3);
    RAM64(in=in, load=loadReg4, address=address[0..5], out=reg4);
    RAM64(in=in, load=loadReg5, address=address[0..5], out=reg5);
    RAM64(in=in, load=loadReg6, address=address[0..5], out=reg6);
    RAM64(in=in, load=loadReg7, address=address[0..5], out=reg7);

    // Mux to push RAM stack to output
    Mux8Way16(out=out, sel=address[6..8], a=reg0, b=reg1, c=reg2, d=reg3, e=reg4, f=reg5, g=reg6, h=reg7);
}
